{
  "name": "SaaS Competitor Pricing Monitor",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [ { "field": "hours", "interval": 24 } ] } },
      "name": "Daily Cron",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [200, 300]
    },
    {
      "parameters": {
        "url": "https://competitor.com/pricing",
        "responseFormat": "text"
      },
      "name": "Fetch Pricing HTML",
      "type": "n8n-nodes-base.httpRequest",
      "position": [400, 300]
    },
    {
      "parameters": {
        "operation": "extractHtmlContent",
        "extractionValues": {
          "values": [ { "key": "pricing_tier", "cssSelector": ".price-amount", "returnValue": "text" } ]
        }
      },
      "name": "Extract Pricing Data",
      "type": "n8n-nodes-base.html",
      "position": [600, 300]
    },
    {
      "parameters": {
        "channel": "#exec-strategy",
        "text": "=Competitor pricing scan complete. Current tiers detected: {{ $json.pricing_tier }}"
      },
      "name": "Slack Alert",
      "type": "n8n-nodes-base.slack",
      "position": [800, 300]
    }
  ]
}
